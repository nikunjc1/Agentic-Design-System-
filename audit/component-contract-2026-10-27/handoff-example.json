      "type": "button",
      "aria-label": "Continue"
    },
    "styles": {
      "display": "inline-flex",
      "gap": "var(--space-example)",
      "padding": "12px"
    },
    "children": [
      {
        "id": "label",
        "name": "Label",
        "kind": "text",
        "tag": "span",
        "bind": "label",
        "styles": {},
        "visibleWhen": [
          {
            "property": "showLabel",
            "equals": true
          }
        ]
      }
    ]
  },
  "variants": [],
  "tokens": {
    "--space-example": "8px"
  },
  "behaviors": [
    {
      "target": "root",
      "event": "click",
      "property": "showLabel",
      "value": "$toggle"
    }
  ],
  "accessibility": [
    "Keep an accessible name when the visible label is hidden."
  ],
  "adapters": {
    "figma": {
      "variableMap": {}
